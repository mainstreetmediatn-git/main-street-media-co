{
  "name": "mainstreetmediaco",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.api.json && tsc --noEmit -p tsconfig.node.json",
    "lint": "eslint .",
    "test": "vitest run",
    "ci": "npm run typecheck && npm run lint && npm test && npm run build",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "@vitejs/plugin-react": "4.7.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "resend": "6.16.0",
    "typescript": "5.9.3",
    "vite": "6.4.3"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@types/node": "22.19.7",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.1",
    "globals": "16.5.0",
    "typescript-eslint": "8.52.0",
    "vitest": "3.2.7"
  }
}
